# Kalshi API Credentials
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_DEMO_API_KEY_ID=your_kalshi_demo_api_key_id
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi.key
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_USE_DEMO=true

# Safety Switch: Set to true for live orders, false for simulation
ENABLE_LIVE_ORDERS=false
