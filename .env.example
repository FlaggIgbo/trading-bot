# Kalshi API Credentials
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_DEMO_API_KEY_ID=your_kalshi_demo_api_key_id
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi.key
KALSHI_DEMO_PRIVATE_KEY_PATH=/path/to/your/kalshi_demo.key
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_USE_DEMO=true

# Safety Switch: Set to true for live orders, false for simulation
ENABLE_LIVE_ORDERS=false

# ==============================================================================
# S3 Log & Artifact Storage (Cloudflare R2 for Prod, MinIO for Local Dev)
# ==============================================================================
# Backend mode: 'auto' (default, uses R2 for prod, MinIO for dev/demo), 'r2', 'minio', or 'local'
LOG_STORAGE_BACKEND=auto

# Production: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=trading-bot-logs-prod
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# Local Development: MinIO (run via docker: `docker compose up -d`)
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=trading-bot-logs-dev

# ClickHouse Analytics Configuration (Optional - falls back to in-memory/console if unreachable)
# In docker: run `docker compose up -d` to launch ClickHouse on port 8123
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false
# Only stream log.error and log.warn issues to ClickHouse
CLICKHOUSE_LOG_LEVEL=WARNING
CLICKHOUSE_ONLY_ISSUES=true
