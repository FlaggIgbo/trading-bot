# =============================================================================
# Trading Bot Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Kalshi API (primary prediction market)
# -----------------------------------------------------------------------------
# Get credentials from https://kalshi.com/account/profile (production)
# or https://demo.kalshi.com (demo/sandbox)

# API Key ID (UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
KALSHI_API_KEY_ID=your_kalshi_api_key_id

# Path to private key .key file (downloaded once when creating API key)
# Or use KALSHI_PRIVATE_KEY with PEM content and \n for newlines
KALSHI_PRIVATE_KEY_PATH=/path/to/your/trading-bot.key

# Base URL - use demo for testing, production for real trading
# Demo: https://demo-api.kalshi.co/trade-api/v2
# Production: https://api.elections.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Set to "true" to use demo/sandbox (ignored if KALSHI_BASE_URL is set)
# KALSHI_USE_DEMO=true

# -----------------------------------------------------------------------------
# Gemini Exchange API (secondary - crypto prediction markets)
# -----------------------------------------------------------------------------
# Required only for Gemini order placement. Get from https://exchange.gemini.com
# GEMINI_API_KEY and GEMINI_API_SECRET must both be set for authenticated calls.

# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_API_SECRET=your_gemini_api_secret

# Required if using a Master API key (master-*). Add your account nickname.
# Find it at Gemini Settings > Accounts, or try "Primary" for the default trading account.
# GEMINI_ACCOUNT=Primary

# Use sandbox: https://api.sandbox.gemini.com
# GEMINI_USE_SANDBOX=false

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------
# Override config.yaml markets (comma-separated list)
# MARKETS=KXBTCD,KXETHD,KXSOLD,KXINXU,KXXRPD

# Override poll interval in seconds (engine scripts)
# POLL_INTERVAL_SECONDS=10

# Ollama model for LLM analysis (compare_historical.py, compare_prices.py)
# OLLAMA_MODEL=llama3.2

# Enable yfinance / underlying-client debug output
# YFINANCE_DEBUG=true

# Use SPY ETF as an S&P 500 proxy (combined with ^GSPC). Set to 0/false/no to disable.
# YFINANCE_SPY_AS_SP500=1

# Underlying crypto spot: Gemini Exchange public REST first (default on). Set to 0/false/no to use Yahoo only.
# YFINANCE_CRYPTO_GEMINI=0

# Optional override for Gemini spot API host (default https://api.gemini.com)
# GEMINI_SPOT_API_BASE=https://api.gemini.com
